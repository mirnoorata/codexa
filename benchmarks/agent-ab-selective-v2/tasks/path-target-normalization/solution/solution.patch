+def _is_safe_relative_target(target: str) -> bool:
+    if target.startswith("/") or target.startswith("\\") or _WINDOWS_DRIVE.match(target):
+        return False
+    if "\\" in target:
+        return False
+    return ".." not in target.split("/")
